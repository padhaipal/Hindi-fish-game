# --- Play gate (single-play) — all optional ---

# How long a game stays "used" on a device after it's opened (hours).
# Default 168 (7 days).
# COOLDOWN_HOURS=168

# Turn the cooldown gate off entirely (handy for local dev).
# GATE_DISABLED=1

# --- Analytics (PostHog) — optional ---
# Paste your PostHog *project* API key (starts with phc_). It's a public,
# client-side key — safe to expose. If unset, analytics is completely off.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog host. Use the EU host if you signed up for the EU region.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
