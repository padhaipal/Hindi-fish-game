# --- One-time link gate (single-play) ---
# Copy to .env.local for local dev, or set these in your Vercel project.
# Leave LINK_SECRET unset to run with the gate OFF (all routes open).

# Required to ENABLE the gate. Any long random string, shared with your bot.
LINK_SECRET=

# Guards /api/mint so only your bot can create links.
MINT_SECRET=

# The shared "burn" store — REQUIRED in production (Upstash Redis, free tier).
# Without it the app falls back to a per-instance in-memory store that is NOT
# reliable across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: force the gate off even if LINK_SECRET is set.
# GATE_DISABLED=1
